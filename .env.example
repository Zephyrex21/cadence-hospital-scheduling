# Copy to backend/.env for local development. Variables are read with the CADENCE_ prefix.

# --- Database ---
# SQLite (zero setup):
CADENCE_DATABASE_URL=sqlite+pysqlite:///./cadence.db
# PostgreSQL via `docker compose up -d db` (this is also the default if unset):
# CADENCE_DATABASE_URL=postgresql+psycopg://cadence:cadence_dev_password@localhost:5432/cadence

# docker-compose.yml only (the app itself does NOT read these):
POSTGRES_USER=cadence
POSTGRES_PASSWORD=cadence_dev_password
POSTGRES_DB=cadence
POSTGRES_PORT=5432

# --- Backend ---
CADENCE_ENV=development            # set to "production" in any real deployment
# Clinic-local timezone: defines "today" for the schedule/queue/dashboard. Storage is always UTC.
CADENCE_CLINIC_TIMEZONE=Asia/Kolkata
# Comma-separated origins allowed by CORS.
CADENCE_CORS_ORIGINS=http://localhost:5173

# --- Secrets (REQUIRED in production) ---
# >= 32 random characters. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Unset in development => a random per-process secret is used (sessions reset on restart).
# CADENCE_JWT_SECRET=
# Password for seeded demo staff. Required to seed when CADENCE_ENV=production;
# setting it also rotates already-seeded accounts. Unset in dev => "cadence123".
# CADENCE_SEED_PASSWORD=

# --- MongoDB Atlas profile store (optional) ---
# Patient / doctor / nurse / receptionist details live in MongoDB; Postgres/SQLite keeps
# identity, auth and scheduling. Leave unset to run without it (the app works as before).
# Atlas: create an M0 cluster, a DB user with readWrite on the "cadence" database only, allow
# the host in Network Access (Render's free tier has no fixed IP, so 0.0.0.0/0), then copy the
# mongodb+srv:// string (URL-encode special characters in the password).
# CADENCE_MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
# CADENCE_MONGODB_DB=cadence

# --- Operations ---
# Apply `alembic upgrade head` automatically on API startup (default true).
# CADENCE_AUTO_MIGRATE=true

# Refresh the Indian demo data on every start (for hosts with no shell). Idempotent:
# updates demo records in place, never wipes. Needs CADENCE_SEED_PASSWORD in production.
# CADENCE_SEED_DEMO_ON_START=false

# --- Reverse proxies (login throttle) ---
# Number of trusted proxies in front of the API, so the login throttle buckets by the REAL
# client IP instead of the proxy's. 0 = none (default, local dev). Render alone = 1.
# Browser -> Vercel rewrite (/api) -> Render = 2. Wrong values either lock everyone out
# together (too low) or let X-Forwarded-For be spoofed (too high).
# CADENCE_TRUSTED_PROXY_COUNT=2

# --- Safety switches (leave at defaults) ---
# CADENCE_ALLOW_CLIENT_NOW=false     # test/E2E only; startup fails if true in production
# CADENCE_LOGIN_MAX_ATTEMPTS=5
# CADENCE_LOGIN_WINDOW_SEC=900
