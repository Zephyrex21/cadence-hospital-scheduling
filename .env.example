# Copy to .env for local development.

# --- Database (used from Phase 1 onward) ---
POSTGRES_USER=cadence
POSTGRES_PASSWORD=cadence_dev_password
POSTGRES_DB=cadence
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Full SQLAlchemy URL (derived from the above in app config; override if needed)
# DATABASE_URL=postgresql+psycopg://cadence:cadence_dev_password@localhost:5432/cadence

# --- Backend ---
CADENCE_ENV=development
# Clinic-local timezone used for display; storage is always UTC.
CADENCE_CLINIC_TIMEZONE=UTC
# Comma-separated origins allowed by CORS.
CADENCE_CORS_ORIGINS=http://localhost:5173
